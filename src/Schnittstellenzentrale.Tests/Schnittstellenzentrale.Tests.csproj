<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit.v3 test projects are self-running Microsoft.Testing.Platform
         executables. dotnet test runs them in MTP mode (opted in via the
         test.runner entry in global.json); the VSTest target is unavailable for
         MTP apps on .NET 10+ SDKs. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <!-- xUnit1051 (TestContext.Current.CancellationToken weiterreichen) ist ein
         Responsiveness-Hinweis des v3-Analyzers; die Suite reicht historisch
         keine Tokens weiter (~385 Stellen) — schrittweise Einführung bleibt
         einem eigenen Vorhaben vorbehalten.
         BL0016 (try/catch um JS-Interop) greift in Tests nicht: die gemockten
         JSRuntime-/IJSObjectReference-Aufrufe (Moq/bunit) werfen keine
         JSException; Guards wären reine Zeremonie. In den Produktivprojekten
         bleiben beide Diagnosen aktiv und wurden behoben. -->
    <NoWarn>$(NoWarn);xUnit1051;BL0016</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct override on the patched AngleSharp line: bunit 2.15.2 transitively requires
         AngleSharp >= 1.10.1, so the vulnerable AngleSharp 1.4.0 it resolved under bunit 2.7.2
         (GHSA-pgww-w46g-26qg, moderate, mXSS via annotation-xml HTML integration point) can no
         longer be pulled in. The explicit pin keeps the resolution on the patched release
         (1.10.5) above the transitive minimum (>= 1.10.1 from bunit 2.15.2): NuGet's
         nearest-wins resolution picks this direct reference over the transitive one. -->
    <PackageReference Include="AngleSharp" Version="1.10.5" />
    <PackageReference Include="bunit" Version="2.15.2" />
    <!-- coverlet.collector (VSTest data collector) does not work under MTP.
         Microsoft.Testing.Extensions.CodeCoverage is the coverlet-based MTP
         coverage extension and emits coverage.cobertura.xml for the 70% gate;
         TrxReport provides the report-trx option for the CI TRX artifacts. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
    <PackageReference Include="Jint" Version="4.18.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.*" />
    <PackageReference Include="Microsoft.JSInterop" Version="11.0.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.65.1" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="InstallPlaywright" AfterTargets="Build" Condition="'$(SkipPlaywrightInstall)' != 'true'">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\playwright.ps1&quot; install chromium" />
  </Target>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Schnittstellenzentrale.Core\Schnittstellenzentrale.Core.csproj" />
    <ProjectReference Include="..\Schnittstellenzentrale.Infrastructure\Schnittstellenzentrale.Infrastructure.csproj" />
    <ProjectReference Include="..\Schnittstellenzentrale\Schnittstellenzentrale.csproj" />
  </ItemGroup>

</Project>
