<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Schnittstellenzentrale.Core\Schnittstellenzentrale.Core.csproj" />
  </ItemGroup>

  <!-- ASP.NET-Core-APIs (Hub/IHubContext in SignalRNotificationService, IHttpContextAccessor
       in WindowsCurrentUserService) kommen aus dem Shared Framework statt aus den
       Legacy-Paketen Microsoft.AspNetCore.Http.Abstractions 2.3.0 und
       Microsoft.AspNetCore.SignalR.Core 1.2.10 - Entscheidung F6, siehe
       docs/projects/task/issue-108-c9b7f84be6d94f939f0c255d1dd1d977-nuget-updates-mit-hohem-risiko/decisions.md.
       Mit der FrameworkReference stellt das Shared Framework auch
       Microsoft.Extensions.Configuration.Abstractions/-Binder,
       Microsoft.Extensions.DependencyInjection.Abstractions, Microsoft.Extensions.Http,
       Microsoft.JSInterop und System.Security.Cryptography.Pkcs bereit - die frueheren
       direkten PackageReferences waren damit redundant (NU1510) und wurden entfernt.
       Zur Pkcs-Sicherheitslage (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7): die
       fruehere 11.0.*-Pinning-Begruendung entfaellt, weil Pkcs nun aus der
       Runtime-Installation kommt und ueber deren Patches auf der gepatchten
       Linie bleibt; die transitive EF.SqlServer-Anforderung wird auf das
       Framework-Asset gekuerzt. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.9.2" />
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.*" />
    <PackageReference Include="Microsoft.OData.Edm" Version="9.0.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.10.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

</Project>
