<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Schnittstellenzentrale.Core\Schnittstellenzentrale.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.9.2" />
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Core" Version="1.2.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.*" />
    <PackageReference Include="Microsoft.JSInterop" Version="11.0.*" />
    <PackageReference Include="Microsoft.OData.Edm" Version="8.4.3" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.10.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <!-- Direct override to keep System.Security.Cryptography.Pkcs on the patched
         line for GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7 (moderate):
         Microsoft.EntityFrameworkCore.SqlServer requires a patched Pkcs version
         transitively anyway; the explicit reference keeps the resolution on the
         patched line - every 11.x release is patched, so the 11.0.*
         float stays safe and tracks future patches together with the floating
         EF references. NuGet's nearest-wins resolution picks this direct
         reference over the transitive one; the pin propagates to referencing
         projects. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

</Project>
